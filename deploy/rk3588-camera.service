[Unit]
Description=RK3588 YOLOv5 Camera Inference
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=rkcamera
Group=rkcamera
SupplementaryGroups=video render
EnvironmentFile=/etc/rk3588-camera/camera.env
ExecStartPre=/opt/rk3588-camera/current/bin/healthcheck
ExecStart=/opt/rk3588-camera/current/bin/yolov5_video ${MODEL_PATH} ${SOURCE} ${OUTPUT} ${MAX_FRAMES}
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/rk3588-camera
WorkingDirectory=/var/lib/rk3588-camera
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
